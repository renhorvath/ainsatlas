FIRECRAWL_API_KEY=
ANTHROPIC_API_KEY=

# Copy to .env at repo root for local runs. Same keys in Vercel → Environment Variables.

# Required on Vercel: Project → Storage → Blob → Create and link to this project.
# Vercel injects BLOB_READ_WRITE_TOKEN and/or BLOB_2_READ_WRITE_TOKEN etc. when stores are linked.
# If you delete a Blob store, remove its env var too — a stale token causes "store does not exist".
