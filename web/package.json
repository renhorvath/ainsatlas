{
  "name": "european-music-conference-atlas",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0 <23"
  },
  "scripts": {
    "predev": "node scripts/check-node.mjs",
    "dev": "rm -rf .next && next dev",
    "dev:incremental": "node scripts/check-node.mjs && next dev",
    "dev:clean": "node scripts/check-node.mjs && rm -rf .next && next dev",
    "dev:turbo": "node scripts/check-node.mjs && next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "next": "^15.5.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.25.0",
    "eslint-config-next": "^15.5.7",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.0"
  }
}
